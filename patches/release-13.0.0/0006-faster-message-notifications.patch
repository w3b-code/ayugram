+/// Save the exact message before displaying its push without waiting for a complete
+/// getDifference/getChannelDifference cycle. Retains the normal server-message parser,
+/// attribute merge and media references, so subsequent deletions can still be archived.
+public func ayuLoadNotificationMessage(postbox: Postbox, network: Network, accountPeerId: PeerId, id: MessageId) -> Signal<Bool, NoError> {
+    return (_internal_getMessagesLoadIfNecessary([id], postbox: postbox, network: network, accountPeerId: accountPeerId)
+    |> `catch` { _ -> Signal<GetMessagesResult, NoError> in
+        return .single(.result([]))
+    })
+    |> mapToSignal { result -> Signal<Bool, NoError> in
+        switch result {
+        case .progress:
+            return .complete()
+        case let .result(messages):
+            return .single(messages.contains(where: { $0.id == id }))
+        }
+    }
+    |> take(1)
+}
