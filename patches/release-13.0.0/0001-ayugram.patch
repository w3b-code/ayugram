diff --git a/submodules/SettingsUI/Sources/AyuGram/AyuGramSettingsController.swift b/submodules/SettingsUI/Sources/AyuGram/AyuGramSettingsController.swift
new file mode 100644
index 00000000..4ee828b5
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuGram/AyuGramSettingsController.swift
@@ -0,0 +1,236 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+import AyuGramSettings
+
+private final class AyuGramSettingsControllerArguments {
+    let update: ((inout AyuSettingsValues) -> Void) -> Void
+
+    init(update: @escaping ((inout AyuSettingsValues) -> Void) -> Void) {
+        self.update = update
+    }
+}
+
+private enum AyuGramSettingsSection: Int32 {
+    case ghost
+    case ghostOptions
+    case ghostExtras
+    case sendWithoutSound
+    case saving
+    case interface
+    case peerId
+}
+
+/// A switch on the screen and the setting it changes.
+private enum AyuGramToggle: Equatable {
+    case ghostMode
+    case sendReadMessages
+    case sendReadStories
+    case sendOnline
+    case sendTyping
+    case sendOfflineAfterOnline
+    case markReadAfterAction
+    case suggestGhostForStories
+    case ghostStatusInChatList
+    case saveDeleted
+    case saveHistory
+    case semiTransparent
+    case keepAlive
+    case disableAds
+    case hideStories
+    case disableNumberRounding
+    case showMessageSeconds
+    case showProfileTab
+
+    func apply(_ values: inout AyuSettingsValues, _ value: Bool) {
+        switch self {
+        case .ghostMode:
+            values.ghostModeEnabled = value
+        // The ghost options are shown as AyuGram4A shows them: on means the packet is held back.
+        case .sendReadMessages:
+            values.sendReadMessagePackets = !value
+        case .sendReadStories:
+            values.sendReadStoryPackets = !value
+        case .sendOnline:
+            values.sendOnlinePackets = !value
+        case .sendTyping:
+            values.sendUploadProgress = !value
+        case .sendOfflineAfterOnline:
+            values.sendOfflinePacketAfterOnline = value
+        case .markReadAfterAction:
+            values.markReadAfterAction = value
+        case .suggestGhostForStories:
+            values.suggestGhostModeBeforeViewingStory = value
+        case .ghostStatusInChatList:
+            values.displayGhostStatus = value
+        case .saveDeleted:
+            values.saveDeletedMessages = value
+        case .saveHistory:
+            values.saveMessagesHistory = value
+        case .semiTransparent:
+            values.semiTransparentDeletedMessages = value
+        case .keepAlive:
+            values.keepAliveInBackground = value
+        case .disableAds:
+            values.disableAds = value
+        case .hideStories:
+            values.hideStories = value
+        case .disableNumberRounding:
+            values.disableNumberRounding = value
+        case .showMessageSeconds:
+            values.showMessageSeconds = value
+        case .showProfileTab:
+            values.showProfileTab = value
+        }
+    }
+}
+
+/// One option of a single-choice list.
+private enum AyuGramChoice: Equatable {
+    case sendWithoutSound(AyuSendWithoutSound)
+    case peerIdFormat(AyuPeerIdFormat)
+
+    func apply(_ values: inout AyuSettingsValues) {
+        switch self {
+        case let .sendWithoutSound(value):
+            values.sendWithoutSound = value
+        case let .peerIdFormat(value):
+            values.peerIdFormat = value
+        }
+    }
+}
+
+private enum AyuGramSettingsEntry: ItemListNodeEntry {
+    case header(id: Int32, section: AyuGramSettingsSection, text: String)
+    case toggle(id: Int32, section: AyuGramSettingsSection, toggle: AyuGramToggle, title: String, value: Bool, enabled: Bool)
+    case choice(id: Int32, section: AyuGramSettingsSection, choice: AyuGramChoice, title: String, checked: Bool)
+    case footer(id: Int32, section: AyuGramSettingsSection, text: String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case let .header(_, section, _), let .toggle(_, section, _, _, _, _), let .choice(_, section, _, _, _), let .footer(_, section, _):
+            return section.rawValue
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case let .header(id, _, _), let .toggle(id, _, _, _, _, _), let .choice(id, _, _, _, _), let .footer(id, _, _):
+            return id
+        }
+    }
+
+    static func <(lhs: AyuGramSettingsEntry, rhs: AyuGramSettingsEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyuGramSettingsControllerArguments
+        switch self {
+        case let .header(_, _, text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .toggle(_, _, toggle, title, value, enabled):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: title, value: value, enabled: enabled, sectionId: self.section, style: .blocks, updated: { value in
+                arguments.update { toggle.apply(&$0, value) }
+            })
+        case let .choice(_, _, choice, title, checked):
+            return ItemListCheckboxItem(presentationData: presentationData, systemStyle: .glass, title: title, style: .left, checked: checked, zeroSeparatorInsets: false, sectionId: self.section, action: {
+                arguments.update { choice.apply(&$0) }
+            })
+        case let .footer(_, _, text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
+
+private func ayuGramSettingsEntries(values: AyuSettingsValues) -> [AyuGramSettingsEntry] {
+    var entries: [AyuGramSettingsEntry] = []
+    var nextId: Int32 = 0
+    func add(_ make: (Int32) -> AyuGramSettingsEntry) {
+        entries.append(make(nextId))
+        nextId += 1
+    }
