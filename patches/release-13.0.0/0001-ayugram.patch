diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuMessageAttributes.swift b/submodules/TelegramCore/Sources/AyuGram/AyuMessageAttributes.swift
new file mode 100644
index 00000000..9d4c390a
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuMessageAttributes.swift
@@ -0,0 +1,273 @@
+import Foundation
+import AyuGramSettings
+import Postbox
+import SwiftSignalKit
+import TelegramApi
+
+/// Marks a message the server deleted while AyuGram kept the local copy.
+///
+/// Kept across later updates of the message by `mergeMessageAttributes`.
+public final class AyuDeletedMessageAttribute: MessageAttribute {
+    public let deletedAt: Int32
+
+    public init(deletedAt: Int32) {
+        self.deletedAt = deletedAt
+    }
+
+    required public init(decoder: PostboxDecoder) {
+        self.deletedAt = decoder.decodeInt32ForKey("d", orElse: 0)
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeInt32(self.deletedAt, forKey: "d")
+    }
+}
+
+/// The earlier texts of an edited message, oldest first.
+///
+/// Kept across later updates of the message by `mergeMessageAttributes`.
+public final class AyuEditHistoryMessageAttribute: MessageAttribute {
+    public struct Revision: Equatable {
+        public let text: String
+        /// When this text was posted: the message date for the first revision, the edit date after.
+        public let date: Int32
+
+        public init(text: String, date: Int32) {
+            self.text = text
+            self.date = date
+        }
+    }
+
+    public let revisions: [Revision]
+
+    public init(revisions: [Revision]) {
+        self.revisions = revisions
+    }
+
+    required public init(decoder: PostboxDecoder) {
+        let texts = decoder.decodeStringArrayForKey("t")
+        let dates = decoder.decodeInt32ArrayForKey("d")
+        var revisions: [Revision] = []
+        for i in 0 ..< min(texts.count, dates.count) {
+            revisions.append(Revision(text: texts[i], date: dates[i]))
+        }
+        self.revisions = revisions
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeStringArray(self.revisions.map(\.text), forKey: "t")
+        encoder.encodeInt32Array(self.revisions.map(\.date), forKey: "d")
+    }
+
+    public func withAppended(_ revision: Revision) -> AyuEditHistoryMessageAttribute {
+        return AyuEditHistoryMessageAttribute(revisions: self.revisions + [revision])
+    }
+}
+
+extension Message {
+    public var ayuDeletedAttribute: AyuDeletedMessageAttribute? {
+        return self.attributes.first(where: { $0 is AyuDeletedMessageAttribute }) as? AyuDeletedMessageAttribute
+    }
+
+    public var ayuEditHistoryAttribute: AyuEditHistoryMessageAttribute? {
+        return self.attributes.first(where: { $0 is AyuEditHistoryMessageAttribute }) as? AyuEditHistoryMessageAttribute
+    }
+}
+
+/// Keeps AyuGram's attributes when Postbox replaces a message's attributes with the server's copy.
+func ayuMergeMessageAttributes(_ previous: [MessageAttribute], _ updated: inout [MessageAttribute]) {
+    if let deleted = previous.first(where: { $0 is AyuDeletedMessageAttribute }), !updated.contains(where: { $0 is AyuDeletedMessageAttribute }) {
+        updated.append(deleted)
+    }
+    if let history = previous.first(where: { $0 is AyuEditHistoryMessageAttribute }), !updated.contains(where: { $0 is AyuEditHistoryMessageAttribute }) {
+        updated.append(history)
+    }
+}
+
+/// Marks the stored messages among `ids` as deleted instead of removing them.
+///
+/// Returns the ids that must still be deleted the usual way: those not stored, and local or
+/// scheduled messages, which are not chat history.
+func ayuMarkMessagesDeleted(transaction: Transaction, ids: [MessageId]) -> [MessageId] {
+    let timestamp = Int32(Date().timeIntervalSince1970)
+    var remaining: [MessageId] = []
+    for id in ids {
+        guard id.namespace == Namespaces.Message.Cloud, let message = transaction.getMessage(id) else {
+            remaining.append(id)
+            continue
+        }
+        if message.ayuDeletedAttribute != nil {
+            continue
+        }
+        transaction.updateMessage(id, update: { current in
+            var attributes = current.attributes
+            attributes.append(AyuDeletedMessageAttribute(deletedAt: timestamp))
+            let storeForwardInfo = current.forwardInfo.flatMap { forwardInfo in
+                StoreMessageForwardInfo(authorId: forwardInfo.author?.id, sourceId: forwardInfo.source?.id, sourceMessageId: forwardInfo.sourceMessageId, date: forwardInfo.date, authorSignature: forwardInfo.authorSignature, psaType: forwardInfo.psaType, flags: forwardInfo.flags)
+            }
+            return .update(StoreMessage(id: current.id, customStableId: nil, globallyUniqueId: current.globallyUniqueId, groupingKey: current.groupingKey, threadId: current.threadId, timestamp: current.timestamp, flags: StoreMessageFlags(current.flags), tags: current.tags, globalTags: current.globalTags, localTags: current.localTags, forwardInfo: storeForwardInfo, authorId: current.author?.id, text: current.text, attributes: attributes, media: current.media))
+        })
+    }
+    return remaining
+}
+
+/// Deletes messages for a MESSAGE_DELETED push in the notification extension, which shares the
+/// app's database: the saved ones are marked deleted, as when the app itself gets the deletion.
+public func ayuDeleteMessagesFromPush(transaction: Transaction, mediaBox: MediaBox, ids: [MessageId]) {
+    var ids = ids
+    if AyuSettings.shared.values.saveDeletedMessages {
+        ids = ayuMarkMessagesDeleted(transaction: transaction, ids: ids)
+    }
+    _internal_deleteMessages(transaction: transaction, mediaBox: mediaBox, ids: ids, deleteMedia: true)
+}
+
+/// The edit history after `previous` is replaced by `updated`, or nil when the text did not change.
+func ayuEditHistory(previous: Message, updated: StoreMessage) -> AyuEditHistoryMessageAttribute? {
+    if previous.text == updated.text || previous.text.isEmpty {
+        return nil
+    }
+    var editDate = previous.timestamp
+    for attribute in previous.attributes {
+        if let attribute = attribute as? EditedMessageAttribute {
+            editDate = attribute.date
+        }
+    }
+    let revision = AyuEditHistoryMessageAttribute.Revision(text: previous.text, date: editDate)
+    if let history = previous.ayuEditHistoryAttribute {
+        return history.withAppended(revision)
+    } else {
+        return AyuEditHistoryMessageAttribute(revisions: [revision])
+    }
+}
+
+/// Applies AyuGram's sending options to messages the user is about to send to `peerId`.
+func ayuPrepareOutgoingMessages(account: Account, peerId: PeerId, messages: [EnqueueMessage]) -> [EnqueueMessage] {
+    let settings = AyuSettings.shared.values
+    if settings.marksReadAfterAction {
+        ayuMarkReadAfterAction(account: account, peerId: peerId)
+    }
+    if settings.sendsOfflineAfterAction {
+        ayuSendOfflineAfterAction(account: account)
+    }
+    guard settings.sendsWithoutSound else {
+        return messages
+    }
+    return messages.map { message in
+        return message.withUpdatedAttributes { attributes in
+            var attributes = attributes
+            var flags: NotificationInfoMessageAttributeFlags = .muted
+            if let index = attributes.firstIndex(where: { $0 is NotificationInfoMessageAttribute }), let current = attributes[index] as? NotificationInfoMessageAttribute {
+                flags.formUnion(current.flags)
+                attributes.remove(at: index)
+            }
+            attributes.append(NotificationInfoMessageAttribute(flags: flags))
+            return attributes
+        }
+    }
+}
+
+/// Ghost mode's "read after action": reports the chat read up to its newest message, bypassing the
+/// filter that holds back the read packets.
+func ayuMarkReadAfterAction(account: Account, peerId: PeerId) {
+    guard peerId.namespace == Namespaces.Peer.CloudUser || peerId.namespace == Namespaces.Peer.CloudGroup || peerId.namespace == Namespaces.Peer.CloudChannel else {
+        return
+    }
+    let network = account.network
+    let _ = (account.postbox.transaction { transaction -> (Peer?, Int32?) in
+        return (transaction.getPeer(peerId), transaction.getTopPeerMessageId(peerId: peerId, namespace: Namespaces.Message.Cloud)?.id)
+    }
+    |> mapToSignal { peer, maxId -> Signal<Never, NoError> in
+        guard let peer = peer, let maxId = maxId else {
+            return .complete()
+        }
+        if peerId.namespace == Namespaces.Peer.CloudChannel {
+            guard let inputChannel = apiInputChannel(peer) else {
+                return .complete()
+            }
+            return network.request(Api.functions.channels.readHistory(channel: inputChannel, maxId: maxId), ayuBypass: true)
+            |> ignoreValues
+            |> `catch` { _ -> Signal<Never, NoError> in
+                return .complete()
+            }
+        } else {
+            guard let inputPeer = apiInputPeer(peer) else {
+                return .complete()
+            }
+            return network.request(Api.functions.messages.readHistory(peer: inputPeer, maxId: maxId), ayuBypass: true)
+            |> map(Optional.init)
+            |> `catch` { _ -> Signal<Api.messages.AffectedMessages?, NoError> in
+                return .single(nil)
+            }
+            |> mapToSignal { result -> Signal<Never, NoError> in
+                if let result = result {
+                    switch result {
+                    case let .affectedMessages(affectedMessagesData):
+                        account.stateManager?.addUpdateGroups([.updatePts(pts: affectedMessagesData.pts, ptsCount: affectedMessagesData.ptsCount)])
+                    }
+                }
+                return .complete()
+            }
+        }
+    }).start()
+}
+
+/// Sending a message or a reaction makes the server show the account online; in ghost mode,
+/// "offline" follows once the action has gone out.
+func ayuSendOfflineAfterAction(account: Account) {
+    let network = account.network
+    let _ = (Signal<Never, NoError>.complete()
+    |> delay(2.0, queue: Queue.concurrentDefaultQueue())
+    |> then(
+        network.request(Api.functions.account.updateStatus(offline: .boolTrue))
+        |> ignoreValues
+        |> `catch` { _ -> Signal<Never, NoError> in
+            return .complete()
+        }
+    )).start()
+}
+
+/// AyuGram's "automatic offline", as AyuGram Desktop does it: whenever the server shows the account
+/// online while "online" is hidden (after a sent message, say), "offline" goes out.
+///
+/// Telegram keeps the account's own presence at a local, permanent "online" and drops what the server
+/// reports for it. In ghost mode that local value is replaced by "recently" until the server reports
+/// the real status (see `updatePeerPresences`), and put back when ghost mode is turned off.
+func ayuManagedAutoOffline(postbox: Postbox, network: Network, accountPeerId: PeerId) -> Signal<Never, NoError> {
+    let localPresence = AyuSettings.shared.signal
+    |> map { $0.suppressesOnline }
+    |> distinctUntilChanged
+    |> mapToSignal { suppressesOnline -> Signal<Never, NoError> in
+        return postbox.transaction { transaction -> Void in
+            let status: UserPresenceStatus = suppressesOnline ? .recently(isHidden: false) : .present(until: Int32.max - 1)
+            transaction.updatePeerPresencesInternal(presences: [accountPeerId: TelegramUserPresence(status: status, lastActivity: 0)], merge: { _, updated in return updated })
+        }
+        |> ignoreValues
+    }
+    
+    let isShownOnline = postbox.peerView(id: accountPeerId)
+    |> map { view -> Bool in
+        guard let presence = view.peerPresences[accountPeerId] as? TelegramUserPresence, case let .present(until) = presence.status else {
+            return false
+        }
+        let now = Int32(Date().timeIntervalSince1970)
+        return until > now && until < Int32.max - 1
+    }
+    |> distinctUntilChanged
+    let autoOffline = AyuSettings.shared.signal
+    |> map { $0.sendsOfflineAfterAction }
+    |> distinctUntilChanged
+    let sendOffline = combineLatest(isShownOnline, autoOffline)
+    |> mapToSignal { isShownOnline, autoOffline -> Signal<Never, NoError> in
+        guard isShownOnline && autoOffline else {
+            return .complete()
+        }
+        return network.request(Api.functions.account.updateStatus(offline: .boolTrue))
+        |> ignoreValues
+        |> `catch` { _ -> Signal<Never, NoError> in
+            return .complete()
+        }
+    }
+    
+    return combineLatest(localPresence |> then(.never()), sendOffline |> then(.never()))
+    |> ignoreValues
+}
