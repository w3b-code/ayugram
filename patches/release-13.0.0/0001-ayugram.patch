+/// AyuGram: with "hide stories" on, other people's stories leave the chat list header and the archive;
+/// the account's own item stays, so posting a story still works.
+private func ayuFilteredStorySubscriptions(_ signal: Signal<EngineStorySubscriptions, NoError>) -> Signal<EngineStorySubscriptions, NoError> {
+    return combineLatest(signal, AyuSettings.shared.signal)
+    |> map { subscriptions, settings -> EngineStorySubscriptions in
+        if settings.hideStories {
+            return EngineStorySubscriptions(accountItem: subscriptions.accountItem, items: [], hasMoreToken: nil)
+        }
+        return subscriptions
+    }
+}
