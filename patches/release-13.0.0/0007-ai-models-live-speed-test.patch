-/// Asks every model for a one-word reply at once and lists how fast each answered, or why it did
-/// not: Google publishes no load figures, so the reply time is the measure of how busy a model is.
+private func ayuSpeedTestVerdict(_ result: AyuGeminiResult) -> String {
+    if ayuGeminiAnswer(result.json) != nil {
+        let seconds = String(format: "%.1f", result.elapsed)
+        if result.elapsed < 2.0 {
+            return "🟢 \(seconds) с — свободна"
+        } else if result.elapsed < 5.0 {
+            return "🟡 \(seconds) с — загружена"
+        } else {
+            return "🟠 \(seconds) с — сильно загружена"
+        }
+    } else if result.status == 503 || result.status == 500 {
+        return "🔴 перегружена"
+    } else if result.status == 429 {
+        return "🔴 лимит запросов исчерпан или модель закрыта для бесплатного ключа"
+    } else if result.status == 404 {
+        return "⚪️ недоступна"
+    } else if result.error != nil {
+        return "🔴 нет ответа"
+    } else if result.status == 200 {
+        return "🟠 ответила пустым текстом"
+    } else {
+        return "🔴 ошибка \(result.status)"
+    }
+}
