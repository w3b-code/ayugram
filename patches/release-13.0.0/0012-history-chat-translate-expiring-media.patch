@@ -0,0 +1,158 @@
+import Foundation
+import UIKit
+
+/// One version of an edited message as the history screen shows it.
+public struct AyuEditHistoryEntry {
+    public let text: String
+    public let date: Int32?
+    public let isCurrent: Bool
+
+    public init(text: String, date: Int32?, isCurrent: Bool) {
+        self.text = text
+        self.date = date
+        self.isCurrent = isCurrent
+    }
+}
+
+private final class AyuEditHistoryCell: UITableViewCell {
+    static let reuseIdentifier = "AyuEditHistoryCell"
+
+    private let bubble = UIView()
+    private let textView = UITextView()
+    private let dateLabel = UILabel()
+
+    override init(style: UITableViewCell.CellStyle, reuseIdentifier: String?) {
+        super.init(style: style, reuseIdentifier: reuseIdentifier)
+        self.backgroundColor = .clear
+        self.selectionStyle = .none
+
+        self.bubble.layer.cornerRadius = 17.0
+        self.bubble.translatesAutoresizingMaskIntoConstraints = false
+        self.contentView.addSubview(self.bubble)
+
+        // Selectable, so any earlier text can be copied.
+        self.textView.isEditable = false
+        self.textView.isSelectable = true
+        self.textView.isScrollEnabled = false
+        self.textView.backgroundColor = .clear
+        self.textView.font = UIFont.preferredFont(forTextStyle: .body)
+        self.textView.textContainerInset = .zero
+        self.textView.textContainer.lineFragmentPadding = 0.0
+        self.textView.translatesAutoresizingMaskIntoConstraints = false
+        self.bubble.addSubview(self.textView)
+
+        self.dateLabel.font = UIFont.systemFont(ofSize: 12.0)
+        self.dateLabel.textAlignment = .right
+        self.dateLabel.translatesAutoresizingMaskIntoConstraints = false
+        self.bubble.addSubview(self.dateLabel)
+
+        NSLayoutConstraint.activate([
+            self.bubble.topAnchor.constraint(equalTo: self.contentView.topAnchor, constant: 4.0),
+            self.bubble.bottomAnchor.constraint(equalTo: self.contentView.bottomAnchor, constant: -4.0),
+            self.bubble.leadingAnchor.constraint(equalTo: self.contentView.leadingAnchor, constant: 12.0),
+            self.bubble.trailingAnchor.constraint(lessThanOrEqualTo: self.contentView.trailingAnchor, constant: -48.0),
+            self.textView.topAnchor.constraint(equalTo: self.bubble.topAnchor, constant: 8.0),
+            self.textView.leadingAnchor.constraint(equalTo: self.bubble.leadingAnchor, constant: 12.0),
+            self.textView.trailingAnchor.constraint(equalTo: self.bubble.trailingAnchor, constant: -12.0),
+            self.dateLabel.topAnchor.constraint(equalTo: self.textView.bottomAnchor, constant: 2.0),
+            self.dateLabel.leadingAnchor.constraint(greaterThanOrEqualTo: self.bubble.leadingAnchor, constant: 12.0),
+            self.dateLabel.trailingAnchor.constraint(equalTo: self.bubble.trailingAnchor, constant: -12.0),
+            self.dateLabel.bottomAnchor.constraint(equalTo: self.bubble.bottomAnchor, constant: -6.0)
+        ])
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    func update(entry: AyuEditHistoryEntry) {
+        self.bubble.backgroundColor = entry.isCurrent ? UIColor.systemBlue.withAlphaComponent(0.18) : UIColor.secondarySystemBackground
+        self.textView.text = entry.text.isEmpty ? "(пусто)" : entry.text
+        self.textView.textColor = .label
+        var dateText = entry.isCurrent ? "сейчас" : "изменено"
+        if let date = entry.date {
+            let formatter = DateFormatter()
+            formatter.dateStyle = .short
+            formatter.timeStyle = .short
+            dateText = (entry.isCurrent ? "сейчас · " : "") + formatter.string(from: Date(timeIntervalSince1970: Double(date)))
+        }
+        self.dateLabel.text = dateText
+        self.dateLabel.textColor = .secondaryLabel
+    }
+}
+
+/// Every version of an edited message as a chat: the oldest on top, the current text at the bottom.
+private final class AyuEditHistoryController: UIViewController, UITableViewDataSource {
+    private let entries: [AyuEditHistoryEntry]
+    private let tableView = UITableView(frame: CGRect(), style: .plain)
+
+    init(entries: [AyuEditHistoryEntry]) {
+        self.entries = entries
+        super.init(nibName: nil, bundle: nil)
+        self.title = "История правок"
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.view.backgroundColor = .systemBackground
+        self.navigationItem.leftBarButtonItem = UIBarButtonItem(title: "Закрыть", style: .plain, target: self, action: #selector(self.closePressed))
+
+        self.tableView.dataSource = self
+        self.tableView.separatorStyle = .none
+        self.tableView.backgroundColor = .clear
+        self.tableView.rowHeight = UITableView.automaticDimension
+        self.tableView.estimatedRowHeight = 60.0
+        self.tableView.contentInset = UIEdgeInsets(top: 8.0, left: 0.0, bottom: 8.0, right: 0.0)
+        self.tableView.register(AyuEditHistoryCell.self, forCellReuseIdentifier: AyuEditHistoryCell.reuseIdentifier)
+        self.tableView.translatesAutoresizingMaskIntoConstraints = false
+        self.view.addSubview(self.tableView)
+        NSLayoutConstraint.activate([
+            self.tableView.topAnchor.constraint(equalTo: self.view.topAnchor),
+            self.tableView.bottomAnchor.constraint(equalTo: self.view.bottomAnchor),
+            self.tableView.leadingAnchor.constraint(equalTo: self.view.leadingAnchor),
+            self.tableView.trailingAnchor.constraint(equalTo: self.view.trailingAnchor)
+        ])
+    }
+
+    override func viewDidAppear(_ animated: Bool) {
+        super.viewDidAppear(animated)
+        // Like a chat, it opens at the newest text.
+        if !self.entries.isEmpty {
+            self.tableView.scrollToRow(at: IndexPath(row: self.entries.count - 1, section: 0), at: .bottom, animated: false)
+        }
+    }
+
+    func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
+        return self.entries.count
+    }
+
+    func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = tableView.dequeueReusableCell(withIdentifier: AyuEditHistoryCell.reuseIdentifier, for: indexPath)
+        (cell as? AyuEditHistoryCell)?.update(entry: self.entries[indexPath.row])
+        return cell
+    }
+
+    @objc private func closePressed() {
+        self.dismiss(animated: true)
+    }
+}
+
+/// Opens the edit history over `window`. `entries` go oldest first, the current text last.
+public func ayuPresentEditHistory(entries: [AyuEditHistoryEntry], window: UIWindow?) {
+    guard var presenter = window?.rootViewController else {
+        return
+    }
+    while let presented = presenter.presentedViewController {
+        presenter = presented
+    }
+    let navigationController = UINavigationController(rootViewController: AyuEditHistoryController(entries: entries))
+    if let sheet = navigationController.sheetPresentationController {
+        sheet.detents = [.medium(), .large()]
+        sheet.prefersGrabberVisible = true
+    }
+    presenter.present(navigationController, animated: true)
+}
