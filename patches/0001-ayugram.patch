diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuMessageAttributes.swift b/submodules/TelegramCore/Sources/AyuGram/AyuMessageAttributes.swift
new file mode 100644
index 00000000..61533b3d
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuMessageAttributes.swift
@@ -0,0 +1,128 @@
+import Foundation
+import Postbox
+
+/// Marks a message the server deleted while AyuGram kept the local copy.
+///
+/// Kept across later updates of the message by `mergeMessageAttributes`.
+public final class AyuDeletedMessageAttribute: MessageAttribute {
+    public let deletedAt: Int32
+
+    public init(deletedAt: Int32) {
+        self.deletedAt = deletedAt
+    }
+
+    required public init(decoder: PostboxDecoder) {
+        self.deletedAt = decoder.decodeInt32ForKey("d", orElse: 0)
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeInt32(self.deletedAt, forKey: "d")
+    }
+}
+
+/// The earlier texts of an edited message, oldest first.
+///
+/// Kept across later updates of the message by `mergeMessageAttributes`.
+public final class AyuEditHistoryMessageAttribute: MessageAttribute {
+    public struct Revision: Equatable {
+        public let text: String
+        /// When this text was posted: the message date for the first revision, the edit date after.
+        public let date: Int32
+
+        public init(text: String, date: Int32) {
+            self.text = text
+            self.date = date
+        }
+    }
+
+    public let revisions: [Revision]
+
+    public init(revisions: [Revision]) {
+        self.revisions = revisions
+    }
+
+    required public init(decoder: PostboxDecoder) {
+        let texts = decoder.decodeStringArrayForKey("t")
+        let dates = decoder.decodeInt32ArrayForKey("d")
+        var revisions: [Revision] = []
+        for i in 0 ..< min(texts.count, dates.count) {
+            revisions.append(Revision(text: texts[i], date: dates[i]))
+        }
+        self.revisions = revisions
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeStringArray(self.revisions.map(\.text), forKey: "t")
+        encoder.encodeInt32Array(self.revisions.map(\.date), forKey: "d")
+    }
+
+    public func withAppended(_ revision: Revision) -> AyuEditHistoryMessageAttribute {
+        return AyuEditHistoryMessageAttribute(revisions: self.revisions + [revision])
+    }
+}
+
+extension Message {
+    public var ayuDeletedAttribute: AyuDeletedMessageAttribute? {
+        return self.attributes.first(where: { $0 is AyuDeletedMessageAttribute }) as? AyuDeletedMessageAttribute
+    }
+
+    public var ayuEditHistoryAttribute: AyuEditHistoryMessageAttribute? {
+        return self.attributes.first(where: { $0 is AyuEditHistoryMessageAttribute }) as? AyuEditHistoryMessageAttribute
+    }
+}
+
+/// Keeps AyuGram's attributes when Postbox replaces a message's attributes with the server's copy.
+func ayuMergeMessageAttributes(_ previous: [MessageAttribute], _ updated: inout [MessageAttribute]) {
+    if let deleted = previous.first(where: { $0 is AyuDeletedMessageAttribute }), !updated.contains(where: { $0 is AyuDeletedMessageAttribute }) {
+        updated.append(deleted)
+    }
+    if let history = previous.first(where: { $0 is AyuEditHistoryMessageAttribute }), !updated.contains(where: { $0 is AyuEditHistoryMessageAttribute }) {
+        updated.append(history)
+    }
+}
+
+/// Marks the stored messages among `ids` as deleted instead of removing them.
+///
+/// Returns the ids that must still be deleted the usual way: those not stored, and local or
+/// scheduled messages, which are not chat history.
+func ayuMarkMessagesDeleted(transaction: Transaction, ids: [MessageId]) -> [MessageId] {
+    let timestamp = Int32(Date().timeIntervalSince1970)
+    var remaining: [MessageId] = []
+    for id in ids {
+        guard id.namespace == Namespaces.Message.Cloud, let message = transaction.getMessage(id) else {
+            remaining.append(id)
+            continue
+        }
+        if message.ayuDeletedAttribute != nil {
+            continue
+        }
+        transaction.updateMessage(id, update: { current in
+            var attributes = current.attributes
+            attributes.append(AyuDeletedMessageAttribute(deletedAt: timestamp))
+            let storeForwardInfo = current.forwardInfo.flatMap { forwardInfo in
+                StoreMessageForwardInfo(authorId: forwardInfo.author?.id, sourceId: forwardInfo.source?.id, sourceMessageId: forwardInfo.sourceMessageId, date: forwardInfo.date, authorSignature: forwardInfo.authorSignature, psaType: forwardInfo.psaType, flags: forwardInfo.flags)
+            }
+            return .update(StoreMessage(id: current.id, customStableId: nil, globallyUniqueId: current.globallyUniqueId, groupingKey: current.groupingKey, threadId: current.threadId, timestamp: current.timestamp, flags: StoreMessageFlags(current.flags), tags: current.tags, globalTags: current.globalTags, localTags: current.localTags, forwardInfo: storeForwardInfo, authorId: current.author?.id, text: current.text, attributes: attributes, media: current.media))
+        })
+    }
+    return remaining
+}
+
+/// The edit history after `previous` is replaced by `updated`, or nil when the text did not change.
+func ayuEditHistory(previous: Message, updated: StoreMessage) -> AyuEditHistoryMessageAttribute? {
+    if previous.text == updated.text || previous.text.isEmpty {
+        return nil
+    }
+    var editDate = previous.timestamp
+    for attribute in previous.attributes {
+        if let attribute = attribute as? EditedMessageAttribute {
+            editDate = attribute.date
+        }
+    }
+    let revision = AyuEditHistoryMessageAttribute.Revision(text: previous.text, date: editDate)
+    if let history = previous.ayuEditHistoryAttribute {
+        return history.withAppended(revision)
+    } else {
+        return AyuEditHistoryMessageAttribute(revisions: [revision])
+    }
+}
