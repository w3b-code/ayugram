diff --git a/submodules/SettingsUI/Sources/AyuGram/AyuGramSettingsController.swift b/submodules/SettingsUI/Sources/AyuGram/AyuGramSettingsController.swift
new file mode 100644
index 00000000..aa0e558e
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuGram/AyuGramSettingsController.swift
@@ -0,0 +1,221 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+import AyuGramSettings
+
+private final class AyuGramSettingsControllerArguments {
+    let update: ((inout AyuSettingsValues) -> Void) -> Void
+
+    init(update: @escaping ((inout AyuSettingsValues) -> Void) -> Void) {
+        self.update = update
+    }
+}
+
+private enum AyuGramSettingsSection: Int32 {
+    case ghost
+    case ghostOptions
+    case saving
+    case interface
+}
+
+private enum AyuGramSettingsEntry: ItemListNodeEntry {
+    case ghostHeader
+    case ghostEnabled(Bool)
+    case ghostFooter
+
+    case ghostOptionsHeader
+    case sendReadMessages(Bool, enabled: Bool)
+    case sendReadStories(Bool, enabled: Bool)
+    case sendOnline(Bool, enabled: Bool)
+    case sendTyping(Bool, enabled: Bool)
+    case sendOfflineAfterOnline(Bool, enabled: Bool)
+    case ghostOptionsFooter
+
+    case savingHeader
+    case saveDeleted(Bool)
+    case saveHistory(Bool)
+    case semiTransparent(Bool)
+    case keepAlive(Bool)
+    case savingFooter
+
+    case interfaceHeader
+    case disableAds(Bool)
+    case hideStories(Bool)
+    case interfaceFooter
+
+    var section: ItemListSectionId {
+        switch self {
+        case .ghostHeader, .ghostEnabled, .ghostFooter:
+            return AyuGramSettingsSection.ghost.rawValue
+        case .ghostOptionsHeader, .sendReadMessages, .sendReadStories, .sendOnline, .sendTyping, .sendOfflineAfterOnline, .ghostOptionsFooter:
+            return AyuGramSettingsSection.ghostOptions.rawValue
+        case .savingHeader, .saveDeleted, .saveHistory, .semiTransparent, .keepAlive, .savingFooter:
+            return AyuGramSettingsSection.saving.rawValue
+        case .interfaceHeader, .disableAds, .hideStories, .interfaceFooter:
+            return AyuGramSettingsSection.interface.rawValue
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case .ghostHeader:
+            return 0
+        case .ghostEnabled:
+            return 1
+        case .ghostFooter:
+            return 2
+        case .ghostOptionsHeader:
+            return 3
+        case .sendReadMessages:
+            return 4
+        case .sendReadStories:
+            return 5
+        case .sendOnline:
+            return 6
+        case .sendTyping:
+            return 7
+        case .sendOfflineAfterOnline:
+            return 8
+        case .ghostOptionsFooter:
+            return 9
+        case .savingHeader:
+            return 10
+        case .saveDeleted:
+            return 11
+        case .saveHistory:
+            return 12
+        case .semiTransparent:
+            return 13
+        case .savingFooter:
+            return 14
+        case .interfaceHeader:
+            return 15
+        case .disableAds:
+            return 16
+        case .hideStories:
+            return 17
+        case .interfaceFooter:
+            return 18
+        case .keepAlive:
+            return 19
+        }
+    }
+
+    // Display order; stableId only identifies an entry.
+    private var sortIndex: Int32 {
+        switch self {
+        case .keepAlive:
+            return 13 * 10 + 5
+        default:
+            return self.stableId * 10
+        }
+    }
+
+    static func <(lhs: AyuGramSettingsEntry, rhs: AyuGramSettingsEntry) -> Bool {
+        return lhs.sortIndex < rhs.sortIndex
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyuGramSettingsControllerArguments
+        func toggle(_ title: String, _ value: Bool, enabled: Bool = true, _ apply: @escaping (inout AyuSettingsValues, Bool) -> Void) -> ListViewItem {
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: title, value: value, enabled: enabled, sectionId: self.section, style: .blocks, updated: { value in
+                arguments.update { apply(&$0, value) }
+            })
+        }
+        switch self {
+        case .ghostHeader:
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: "РЕЖИМ ПРИЗРАКА", sectionId: self.section)
+        case let .ghostEnabled(value):
+            return toggle("Режим призрака", value, { $0.ghostModeEnabled = $1 })
+        case .ghostFooter:
+            return ItemListTextItem(presentationData: presentationData, text: .plain("Пока режим включён, сервер не узнаёт о действиях, которые выключены ниже."), sectionId: self.section)
+        case .ghostOptionsHeader:
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: "ЧТО ОТПРАВЛЯТЬ", sectionId: self.section)
+        case let .sendReadMessages(value, enabled):
+            return toggle("Отметки о прочтении", value, enabled: enabled, { $0.sendReadMessagePackets = $1 })
+        case let .sendReadStories(value, enabled):
+            return toggle("Просмотр историй", value, enabled: enabled, { $0.sendReadStoryPackets = $1 })
+        case let .sendOnline(value, enabled):
+            return toggle("Статус «в сети»", value, enabled: enabled, { $0.sendOnlinePackets = $1 })
+        case let .sendTyping(value, enabled):
+            return toggle("«Печатает…» и загрузка", value, enabled: enabled, { $0.sendUploadProgress = $1 })
+        case let .sendOfflineAfterOnline(value, enabled):
+            return toggle("«Не в сети» после «в сети»", value, enabled: enabled, { $0.sendOfflinePacketAfterOnline = $1 })
+        case .ghostOptionsFooter:
+            return ItemListTextItem(presentationData: presentationData, text: .plain("Сообщения, прочитанные в режиме призрака, у собеседника остаются непрочитанными."), sectionId: self.section)
+        case .savingHeader:
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: "СОХРАНЕНИЕ СООБЩЕНИЙ", sectionId: self.section)
+        case let .saveDeleted(value):
+            return toggle("Сохранять удалённые", value, { $0.saveDeletedMessages = $1 })
+        case let .saveHistory(value):
+            return toggle("Сохранять историю правок", value, { $0.saveMessagesHistory = $1 })
+        case let .semiTransparent(value):
+            return toggle("Полупрозрачные удалённые", value, { $0.semiTransparentDeletedMessages = $1 })
+        case let .keepAlive(value):
+            return toggle("Держать в фоне", value, { $0.keepAliveInBackground = $1 })
+        case .savingFooter:
+            return ItemListTextItem(presentationData: presentationData, text: .plain("Удалённые сообщения остаются в чате с меткой 🗑. История правок открывается из меню сообщения. Всё хранится только на этом устройстве.\n\nСообщение сохраняется, только если приложение успело его получить. «Держать в фоне» не даёт iOS усыпить свёрнутое приложение (беззвучное аудио, больше расход батареи). Закрытое смахиванием приложение не работает."), sectionId: self.section)
+        case .interfaceHeader:
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: "ИНТЕРФЕЙС", sectionId: self.section)
+        case let .disableAds(value):
+            return toggle("Блокировать рекламу", value, { $0.disableAds = $1 })
+        case let .hideStories(value):
+            return toggle("Скрыть истории", value, { $0.hideStories = $1 })
+        case .interfaceFooter:
+            return ItemListTextItem(presentationData: presentationData, text: .plain("Реклама в каналах и в поиске не загружается. Истории убираются из списка чатов и архива; в профиле их по-прежнему можно открыть."), sectionId: self.section)
+        }
+    }
+}
+
+private func ayuGramSettingsEntries(values: AyuSettingsValues) -> [AyuGramSettingsEntry] {
+    var entries: [AyuGramSettingsEntry] = []
+    entries.append(.ghostHeader)
+    entries.append(.ghostEnabled(values.ghostModeEnabled))
+    entries.append(.ghostFooter)
+
+    let ghost = values.ghostModeEnabled
+    entries.append(.ghostOptionsHeader)
+    entries.append(.sendReadMessages(values.sendReadMessagePackets, enabled: ghost))
+    entries.append(.sendReadStories(values.sendReadStoryPackets, enabled: ghost))
+    entries.append(.sendOnline(values.sendOnlinePackets, enabled: ghost))
+    entries.append(.sendTyping(values.sendUploadProgress, enabled: ghost))
+    entries.append(.sendOfflineAfterOnline(values.sendOfflinePacketAfterOnline, enabled: ghost && values.sendOnlinePackets))
+    entries.append(.ghostOptionsFooter)
+
+    entries.append(.savingHeader)
+    entries.append(.saveDeleted(values.saveDeletedMessages))
+    entries.append(.saveHistory(values.saveMessagesHistory))
+    entries.append(.semiTransparent(values.semiTransparentDeletedMessages))
+    entries.append(.keepAlive(values.keepAliveInBackground))
+    entries.append(.savingFooter)
+
+    entries.append(.interfaceHeader)
+    entries.append(.disableAds(values.disableAds))
+    entries.append(.hideStories(values.hideStories))
+    entries.append(.interfaceFooter)
+    return entries
+}
+
+public func ayuGramSettingsController(context: AccountContext) -> ViewController {
+    let arguments = AyuGramSettingsControllerArguments(update: { f in
+        AyuSettings.shared.update(f)
+    })
+
+    let signal = combineLatest(queue: .mainQueue(),
+        context.sharedContext.presentationData,
+        AyuSettings.shared.signal
+    )
+    |> map { presentationData, values -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("AyuGram"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: ayuGramSettingsEntries(values: values), style: .blocks, animateChanges: true)
+        return (controllerState, (listState, arguments))
+    }
+
+    return ItemListController(context: context, state: signal)
+}
