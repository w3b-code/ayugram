diff --git a/submodules/AyuGram/AyuGramSettings/Sources/AyuSettings.swift b/submodules/AyuGram/AyuGramSettings/Sources/AyuSettings.swift
new file mode 100644
index 00000000..1786d5e2
--- /dev/null
+++ b/submodules/AyuGram/AyuGramSettings/Sources/AyuSettings.swift
@@ -0,0 +1,148 @@
+import Foundation
+import SwiftSignalKit
+
+/// AyuGram options, shared by every account of the app (AyuGram4A keeps ghost options per account;
+/// here one set applies to all of them).
+///
+/// Read from TelegramCore's network and state queues on every request, so the values live in memory
+/// behind a lock and only writes touch `UserDefaults`.
+public struct AyuSettingsValues: Equatable {
+    // Ghost mode: each `send*` flag says whether that packet still goes to the server.
+    public var ghostModeEnabled: Bool
+    public var sendReadMessagePackets: Bool
+    public var sendReadStoryPackets: Bool
+    public var sendOnlinePackets: Bool
+    public var sendUploadProgress: Bool
+    public var sendOfflinePacketAfterOnline: Bool
+
+    // Message saving.
+    public var saveDeletedMessages: Bool
+    public var saveMessagesHistory: Bool
+    public var semiTransparentDeletedMessages: Bool
+
+    // Interface.
+    public var disableAds: Bool
+    public var hideStories: Bool
+    /// Plays silence while the app is in the background, so iOS does not suspend it and the
+    /// connection stays up to catch deletions and edits.
+    public var keepAliveInBackground: Bool
+
+    public static let `default` = AyuSettingsValues(
+        ghostModeEnabled: false,
+        sendReadMessagePackets: false,
+        sendReadStoryPackets: false,
+        sendOnlinePackets: false,
+        sendUploadProgress: false,
+        sendOfflinePacketAfterOnline: true,
+        saveDeletedMessages: true,
+        saveMessagesHistory: true,
+        semiTransparentDeletedMessages: true,
+        disableAds: true,
+        hideStories: false,
+        keepAliveInBackground: false
+    )
+
+    /// Whether `name` (a TL function name such as `messages.readHistory`) must not reach the server:
+    /// ad requests while ads are disabled, and the ghost mode packets.
+    public func suppressesFunction(_ name: String) -> Bool {
+        switch name {
+        case "messages.getSponsoredMessages", "contacts.getSponsoredPeers":
+            return self.disableAds
+        default:
+            break
+        }
+        guard self.ghostModeEnabled else {
+            return false
+        }
+        switch name {
+        case "messages.readHistory", "channels.readHistory", "messages.readDiscussion", "messages.readSavedHistory", "messages.readMessageContents", "channels.readMessageContents", "messages.readEncryptedHistory":
+            return !self.sendReadMessagePackets
+        case "stories.readStories", "stories.incrementStoryViews":
+            return !self.sendReadStoryPackets
+        case "messages.setTyping", "messages.setEncryptedTyping":
+            return !self.sendUploadProgress
+        default:
+            return false
+        }
+    }
+
+    public var suppressesOnline: Bool {
+        return self.ghostModeEnabled && !self.sendOnlinePackets
+    }
+
+    public var sendsOfflineAfterOnline: Bool {
+        return self.ghostModeEnabled && self.sendOfflinePacketAfterOnline
+    }
+}
+
+public final class AyuSettings {
+    public static let shared = AyuSettings()
+
+    private static let keyPrefix = "ayugram."
+
+    private let defaults: UserDefaults
+    private let lock = NSLock()
+    private var current: AyuSettingsValues
+    private let promise: ValuePromise<AyuSettingsValues>
+
+    private init() {
+        self.defaults = UserDefaults.standard
+        var values = AyuSettingsValues.default
+        func load(_ key: String, _ value: inout Bool) {
+            if let stored = UserDefaults.standard.object(forKey: AyuSettings.keyPrefix + key) as? Bool {
+                value = stored
+            }
+        }
+        load("ghostModeEnabled", &values.ghostModeEnabled)
+        load("sendReadMessagePackets", &values.sendReadMessagePackets)
+        load("sendReadStoryPackets", &values.sendReadStoryPackets)
+        load("sendOnlinePackets", &values.sendOnlinePackets)
+        load("sendUploadProgress", &values.sendUploadProgress)
+        load("sendOfflinePacketAfterOnline", &values.sendOfflinePacketAfterOnline)
+        load("saveDeletedMessages", &values.saveDeletedMessages)
+        load("saveMessagesHistory", &values.saveMessagesHistory)
+        load("semiTransparentDeletedMessages", &values.semiTransparentDeletedMessages)
+        load("disableAds", &values.disableAds)
+        load("hideStories", &values.hideStories)
+        load("keepAliveInBackground", &values.keepAliveInBackground)
+        self.current = values
+        self.promise = ValuePromise(values, ignoreRepeated: true)
+    }
+
+    public var values: AyuSettingsValues {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.current
+    }
+
+    public var signal: Signal<AyuSettingsValues, NoError> {
+        return self.promise.get()
+    }
+
+    public func update(_ f: (inout AyuSettingsValues) -> Void) {
+        self.lock.lock()
+        var updated = self.current
+        f(&updated)
+        self.current = updated
+        self.lock.unlock()
+
+        let defaults = self.defaults
+        func store(_ key: String, _ value: Bool) {
+            defaults.set(value, forKey: AyuSettings.keyPrefix + key)
+        }
+        store("ghostModeEnabled", updated.ghostModeEnabled)
+        store("sendReadMessagePackets", updated.sendReadMessagePackets)
+        store("sendReadStoryPackets", updated.sendReadStoryPackets)
+        store("sendOnlinePackets", updated.sendOnlinePackets)
+        store("sendUploadProgress", updated.sendUploadProgress)
+        store("sendOfflinePacketAfterOnline", updated.sendOfflinePacketAfterOnline)
+        store("saveDeletedMessages", updated.saveDeletedMessages)
+        store("saveMessagesHistory", updated.saveMessagesHistory)
+        store("semiTransparentDeletedMessages", updated.semiTransparentDeletedMessages)
+        store("disableAds", updated.disableAds)
+        store("hideStories", updated.hideStories)
+        store("keepAliveInBackground", updated.keepAliveInBackground)
+
+        self.promise.set(updated)
+    }
+}
