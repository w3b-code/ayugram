diff --git a/submodules/Postbox/Tests/ExcludedUnreadMessageTests.swift b/submodules/Postbox/Tests/ExcludedUnreadMessageTests.swift
new file mode 100644
index 0000000..32cab64
--- /dev/null
+++ b/submodules/Postbox/Tests/ExcludedUnreadMessageTests.swift
@@ -0,0 +1,158 @@
+import Foundation
+import XCTest
+import SwiftSignalKit
+@testable import Postbox
+
+private final class ArchivedUnreadFixtureAttribute: MessageAttribute {
+    static let register: Void = {
+        declareEncodable(ArchivedUnreadFixtureAttribute.self, f: { ArchivedUnreadFixtureAttribute(decoder: $0) })
+    }()
+    var excludesFromUnreadCount: Bool { return true }
+    init() {}
+    init(decoder: PostboxDecoder) {}
+    func encode(_ encoder: PostboxEncoder) {}
+}
+
+final class ExcludedUnreadMessageTests: XCTestCase {
+    private var fixture: PostboxFixture!
+    private let chat = MessageHistoryTableFixture.peerId(980)
+    private let other = MessageHistoryTableFixture.peerId(981)
+    private let namespace = PostboxFixture.messageNamespace
+
+    override func setUp() {
+        super.setUp()
+        let _ = ArchivedUnreadFixtureAttribute.register
+        self.fixture = PostboxFixture(name: "ExcludedUnreadMessageTests")
+    }
+
+    override func tearDown() {
+        self.fixture.close()
+        self.fixture = nil
+        super.tearDown()
+    }
+
+    private func id(_ value: Int32) -> MessageId {
+        return MessageId(peerId: self.chat, namespace: self.namespace, id: value)
+    }
+
+    private func message(_ value: Int32, archived: Bool = false) -> StoreMessage {
+        return MessageHistoryTableFixture.storeMessage(id: self.id(value), timestamp: 2000 + value, text: "m\(value)", flags: [.Incoming, .TopIndexable])
+            .withUpdatedAttributes(archived ? [ArchivedUnreadFixtureAttribute()] : [])
+    }
+
+    private func seed(count: Int32 = 2, readUpTo: Int32 = 0, unread: Int32? = nil) {
+        self.fixture.transaction { transaction in
+            transaction.updatePeersInternal([FixturePeer(id: self.chat, title: "Latest"), FixturePeer(id: self.other, title: "Other")], update: { _, updated in updated })
+            for peer in [self.chat, self.other] {
+                transaction.updatePeerChatListInclusion(peer, inclusion: .ifHasMessagesOrOneOf(groupId: .root, pinningIndex: nil, minTimestamp: nil))
+            }
+            let otherMessage = MessageHistoryTableFixture.storeMessage(id: MessageId(peerId: self.other, namespace: self.namespace, id: 1), timestamp: 1500, text: "older", flags: [.Incoming, .TopIndexable])
+            let _ = transaction.addMessages([otherMessage] + (1...count).map { self.message($0) }, location: .Random)
+            transaction.resetIncomingReadStates([self.chat: [self.namespace: .idBased(maxIncomingReadId: readUpTo, maxOutgoingReadId: 0, maxKnownId: count, count: unread ?? (count - readUpTo), markedUnread: false)]])
+        }
+    }
+
+    private func archive(_ value: Int32) {
+        self.fixture.transaction { transaction in
+            transaction.updateMessage(self.id(value), update: { _ in .update(self.message(value, archived: true)) })
+        }
+    }
+
+    private func unreadCount() -> Int32? {
+        return self.fixture.transaction { $0.getCombinedPeerReadState(self.chat)?.count } ?? nil
+    }
+
+    func testDeletingLatestKeepsChatAtItsPositionWithoutItsUnreadCounter() {
+        self.seed(count: 1)
+        let before = self.fixture.transaction { $0.getPeerChatListIndex(self.chat)?.1 } ?? nil
+        let rows = self.fixture.observe(self.fixture.postbox.tailChatListView(groupId: .root, filterPredicate: nil, count: 10, summaryComponents: ChatListEntrySummaryComponents()) |> map { $0.0 })
+        rows.waitForValues(count: 1)
+        self.archive(1)
+        XCTAssertEqual(self.unreadCount(), 0)
+        XCTAssertEqual(self.fixture.transaction { $0.getPeerChatListIndex(self.chat)?.1 } ?? nil, before)
+        let view = rows.waitForValues(count: 2).last
+        let order = (view?.entries ?? []).compactMap { entry -> PeerId? in
+            if case let .MessageEntry(data) = entry { return data.index.messageIndex.id.peerId }
+            return nil
+        }
+        XCTAssertEqual(order, [self.other, self.chat])
+        let message = self.fixture.transaction { $0.getMessage(self.id(1)) } ?? nil
+        XCTAssertEqual(message?.text, "m1")
+        XCTAssertTrue(message?.flags.contains(.Incoming) == true)
+        XCTAssertTrue(message?.flags.contains(.TopIndexable) == true)
+        XCTAssertTrue(message?.flags.contains(.ExcludedFromUnreadCount) == true)
+        let state = self.fixture.transaction { $0.getPeerReadStates(self.chat)?.first?.1 } ?? nil
+        if case let .idBased(maxRead, _, _, _, _)? = state {
+            XCTAssertEqual(maxRead, 0, "archiving must not mark any message read")
+        } else { XCTFail("missing read state") }
+    }
+
+    func testOtherUnreadMessagesRemainAndRepeatedDeletionDoesNotSubtractTwice() {
+        self.seed(count: 3)
+        self.archive(2)
+        XCTAssertEqual(self.unreadCount(), 2)
+        self.archive(2)
+        XCTAssertEqual(self.unreadCount(), 2)
+        self.fixture.transaction { $0.applyIncomingReadMaxId(self.id(1)) }
+        XCTAssertEqual(self.unreadCount(), 1)
+        self.fixture.transaction { $0.applyIncomingReadMaxId(self.id(3)) }
+        XCTAssertEqual(self.unreadCount(), 0)
+    }
+
+    func testDeletingReadMessageDoesNotRemoveGenuineUnread() {
+        self.seed(count: 2, readUpTo: 1, unread: 1)
+        self.archive(1)
+        XCTAssertEqual(self.unreadCount(), 1)
+    }
+
+    func testServerRefreshCannotRestoreArchivedMessageToUnreadCount() {
+        self.seed()
+        self.archive(2)
+        self.fixture.transaction { transaction in
+            transaction.updateMessage(self.id(2), update: { _ in .update(self.message(2)) })
+        }
+        XCTAssertEqual(self.unreadCount(), 1)
+        let message = self.fixture.transaction { $0.getMessage(self.id(2)) } ?? nil
+        XCTAssertTrue(message?.flags.contains(.ExcludedFromUnreadCount) == true)
+        self.fixture.transaction { $0.applyIncomingReadMaxId(self.id(1)) }
+        XCTAssertEqual(self.unreadCount(), 0)
+    }
+
+    func testRemovingArchivedHistoryDoesNotSubtractAnotherUnreadMessage() {
+        self.seed()
+        self.archive(2)
+        self.fixture.transaction { $0.deleteMessages([self.id(2)], forEachMedia: { _ in }) }
+        XCTAssertEqual(self.unreadCount(), 1)
+    }
+
+    func testFlagRoundtripKeepsIncomingDirectionAndTopIndex() {
+        let original: StoreMessageFlags = [.Incoming, .TopIndexable, .ExcludedFromUnreadCount]
+        XCTAssertEqual(StoreMessageFlags(MessageFlags(original)), original)
+        XCTAssertFalse(MessageFlags(original).isIncomingForUnreadCount)
+        XCTAssertTrue(MessageFlags([.Incoming, .TopIndexable]).isIncomingForUnreadCount)
+    }
+
+    func testAnArchivedMessageInsertedFromHistoryDoesNotIncreaseUnreadCount() {
+        self.seed(count: 1)
+        self.fixture.transaction { transaction in
+            let _ = transaction.addMessages([self.message(2, archived: true)], location: .UpperHistoryBlock)
+        }
+        XCTAssertEqual(self.unreadCount(), 1)
+        self.fixture.transaction { $0.applyIncomingReadMaxId(self.id(1)) }
+        XCTAssertEqual(self.unreadCount(), 0)
+    }
+
+    func testLegacyValidationPreservesAReadPushAlreadyRequestedByTheUser() {
+        self.seed()
+        let operations = self.fixture.observe(self.fixture.postbox.synchronizePeerReadStatesView() |> map { $0.operations })
+        operations.waitForValues(count: 1)
+        self.fixture.transaction { transaction in
+            let _ = transaction.applyInteractiveReadMaxIndex(MessageIndex(id: self.id(1), timestamp: 2001))
+            transaction.setNeedsIncomingReadStateSynchronization(self.chat, preservePendingPush: true)
+        }
+        let latest = operations.waitForValues(count: 2).last
+        if case let .Push(_, thenSync)? = latest?[self.chat] {
+            XCTAssertTrue(thenSync)
+        } else { XCTFail("pending user read push was discarded") }
+    }
+}
