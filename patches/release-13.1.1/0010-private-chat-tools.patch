diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuChatEvents.swift b/submodules/TelegramCore/Sources/AyuGram/AyuChatEvents.swift
new file mode 100644
index 0000000..5ceca85
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuChatEvents.swift
@@ -0,0 +1,95 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+/// What happened in a private chat, for AyuGram's chat tools: AI replies, showing a deletion or an
+/// edit to the person who made it, and deleting their new messages.
+public enum AyuChatEvent {
+    case incoming(id: MessageId, timestamp: Int32, text: String)
+    case deleted(peerId: PeerId, text: String)
+    case edited(peerId: PeerId, oldText: String, newText: String)
+}
+
+public final class AyuChatEvents {
+    /// Events of one replayed update batch with the account they belong to. Sent while the batch is
+    /// being stored: subscribers deliver them on their own queue before touching the database.
+    public static let pipe = ValuePipe<(accountPeerId: PeerId, events: [AyuChatEvent])>()
+}
+
+private func ayuDescribe(text: String, media: [Media]) -> String {
+    var description: String?
+    for item in media {
+        if item is TelegramMediaImage {
+            description = "📷 Фото"
+        } else if let file = item as? TelegramMediaFile {
+            if file.isVoice {
+                description = "🎤 Голосовое сообщение"
+            } else if file.isInstantVideo {
+                description = "⏺ Видеосообщение"
+            } else if file.isSticker {
+                description = "Стикер"
+            } else if file.isVideo {
+                description = "🎬 Видео"
+            } else {
+                description = "📎 Файл"
+            }
+        }
+        if description != nil {
+            break
+        }
+    }
+    if let description {
+        return text.isEmpty ? description : description + "\n" + text
+    }
+    return text
+}
+
+/// Reads what the operations of an update batch do to the other person's messages in private chats,
+/// before they are applied: a deletion or an edit still finds the previous message stored.
+func ayuCollectChatEvents(transaction: Transaction, accountPeerId: PeerId, operations: [AccountStateMutationOperation]) {
+    var events: [AyuChatEvent] = []
+    func isPrivateChat(_ peerId: PeerId) -> Bool {
+        return peerId.namespace == Namespaces.Peer.CloudUser && peerId != accountPeerId
+    }
+    func addDeleted(_ id: MessageId) {
+        guard isPrivateChat(id.peerId), id.namespace == Namespaces.Message.Cloud, let message = transaction.getMessage(id), message.flags.contains(.Incoming), message.ayuDeletedAttribute == nil else {
+            return
+        }
+        let text = ayuDescribe(text: message.text, media: message.media)
+        if !text.isEmpty {
+            events.append(.deleted(peerId: id.peerId, text: text))
+        }
+    }
+    for operation in operations {
+        switch operation {
+        case let .AddMessages(messages, location):
+            guard case .UpperHistoryBlock = location else {
+                continue
+            }
+            for message in messages {
+                guard case let .Id(id) = message.id, id.namespace == Namespaces.Message.Cloud, isPrivateChat(id.peerId), message.flags.contains(.Incoming) else {
+                    continue
+                }
+                events.append(.incoming(id: id, timestamp: message.timestamp, text: message.text))
+            }
+        case let .EditMessage(id, message):
+            guard isPrivateChat(id.peerId), message.flags.contains(.Incoming), let previous = transaction.getMessage(id), previous.text != message.text else {
+                continue
+            }
+            events.append(.edited(peerId: id.peerId, oldText: previous.text, newText: message.text))
+        case let .DeleteMessagesWithGlobalIds(ids):
+            for id in transaction.messageIdsForGlobalIds(ids) {
+                addDeleted(id)
+            }
+        case let .DeleteMessages(ids):
+            for id in ids {
+                addDeleted(id)
+            }
+        default:
+            break
+        }
+    }
+    if !events.isEmpty {
+        AyuChatEvents.pipe.putNext((accountPeerId: accountPeerId, events: events))
+    }
+}
