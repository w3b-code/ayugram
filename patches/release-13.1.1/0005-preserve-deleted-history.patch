 /// Deletes messages for a MESSAGE_DELETED push in the notification extension, which shares the
 /// app's database: the saved ones are marked deleted, as when the app itself gets the deletion.
 public func ayuDeleteMessagesFromPush(transaction: Transaction, mediaBox: MediaBox, ids: [MessageId]) {
-    var ids = ids
-    if AyuSettings.shared.values.saveDeletedMessages {
-        ids = ayuMarkMessagesDeleted(transaction: transaction, ids: ids)
-    }
-    _internal_deleteMessages(transaction: transaction, mediaBox: mediaBox, ids: ids, deleteMedia: true)
+    ayuDeleteMessagesFromHistoryValidation(transaction: transaction, mediaBox: mediaBox, ids: ids)
+}
+
+/// A remote refresh/deletion cannot erase an already saved local archive, even if
+/// saving NEW deletions has since been switched off. Explicit user deletion uses
+/// _internal_deleteMessages directly and still removes the archive normally.
+func ayuDeleteMessagesFromHistoryValidation(transaction: Transaction, mediaBox: MediaBox, ids: [MessageId]) {
+    AyuHistoryRetention.apply(ids: ids, savingEnabled: AyuSettings.shared.values.saveDeletedMessages, isSaved: { id in
+        return transaction.getMessage(id)?.ayuDeletedAttribute != nil
+    }, save: { ids in
+        return ayuMarkMessagesDeleted(transaction: transaction, ids: ids)
+    }, remove: { ids in
+        _internal_deleteMessages(transaction: transaction, mediaBox: mediaBox, ids: ids, deleteMedia: true)
+    })
 }
 
