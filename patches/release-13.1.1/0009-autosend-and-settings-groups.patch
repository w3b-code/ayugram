@@ -0,0 +1,250 @@
+import Foundation
+import UIKit
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import AyuGramSettings
+
+/// A photo or video picked for a template, kept in the app's own folder.
+public struct AyuAutoSendMedia: Codable, Equatable {
+    public var fileName: String
+    public var isVideo: Bool
+    public var width: Int32
+    public var height: Int32
+    public var duration: Double
+}
+
+/// What one chat sends repeatedly: a text, media, or both, every `interval` seconds.
+public struct AyuAutoSendTemplate: Codable, Equatable {
+    public var text: String
+    public var media: [AyuAutoSendMedia]
+    public var interval: Int32
+
+    public static let empty = AyuAutoSendTemplate(text: "", media: [], interval: 60)
+
+    var isSendable: Bool {
+        return (!self.text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty || !self.media.isEmpty) && self.interval > 0
+    }
+}
+
+public struct AyuAutoSendStatus: Equatable {
+    public var isRunning: Bool
+    public var sentCount: Int
+    public var lastSent: Int32?
+
+    static let stopped = AyuAutoSendStatus(isRunning: false, sentCount: 0, lastSent: nil)
+}
+
+/// Sends each chat's template on a timer while the app runs. iOS suspends the app soon after it
+/// goes to the background, and the timer waits with it ("Keep alive in background" prevents that).
+/// Everything here runs on the main queue.
+public final class AyuAutoSender {
+    public static let shared = AyuAutoSender()
+
+    private final class Task {
+        let context: AccountContext
+        let peerId: EnginePeer.Id
+        let threadId: Int64?
+        var interval: Int32
+        var timer: SwiftSignalKit.Timer?
+        var sentCount = 0
+        var lastSent: Int32?
+
+        init(context: AccountContext, peerId: EnginePeer.Id, threadId: Int64?, interval: Int32) {
+            self.context = context
+            self.peerId = peerId
+            self.threadId = threadId
+            self.interval = interval
+        }
+    }
+
+    private var tasks: [String: Task] = [:]
+    private let statuses = ValuePromise<[String: AyuAutoSendStatus]>([:], ignoreRepeated: true)
+    private var settingsDisposable: Disposable?
+
+    private init() {
+        // Turning the feature off in the settings stops every chat.
+        self.settingsDisposable = (AyuSettings.shared.signal
+        |> map { $0.autoSendEnabled }
+        |> distinctUntilChanged
+        |> deliverOnMainQueue).startStrict(next: { [weak self] enabled in
+            if !enabled {
+                self?.stopAll()
+            }
+        })
+    }
+
+    public static func key(context: AccountContext, peerId: EnginePeer.Id, threadId: Int64?) -> String {
+        return "\(context.account.peerId.toInt64()):\(peerId.toInt64()):\(threadId ?? 0)"
+    }
+
+    static var mediaDirectory: URL? {
+        guard let base = try? FileManager.default.url(for: .applicationSupportDirectory, in: .userDomainMask, appropriateFor: nil, create: true) else {
+            return nil
+        }
+        let directory = base.appendingPathComponent("ayu-autosend", isDirectory: true)
+        try? FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        return directory
+    }
+
+    private static func defaultsKey(_ key: String) -> String {
+        return "ayugram.autosend." + key
+    }
+
+    public func template(key: String) -> AyuAutoSendTemplate {
+        guard let data = UserDefaults.standard.data(forKey: AyuAutoSender.defaultsKey(key)), let template = try? JSONDecoder().decode(AyuAutoSendTemplate.self, from: data) else {
+            return .empty
+        }
+        return template
+    }
+
+    public func setTemplate(_ template: AyuAutoSendTemplate, key: String) {
+        let previous = self.template(key: key)
+        if let data = try? JSONEncoder().encode(template) {
+            UserDefaults.standard.set(data, forKey: AyuAutoSender.defaultsKey(key))
+        }
+        // Files no longer in the template are not needed.
+        if let directory = AyuAutoSender.mediaDirectory {
+            for item in previous.media where !template.media.contains(where: { $0.fileName == item.fileName }) {
+                try? FileManager.default.removeItem(at: directory.appendingPathComponent(item.fileName))
+            }
+        }
+        if let task = self.tasks[key], task.interval != template.interval, template.interval > 0 {
+            task.interval = template.interval
+            self.schedule(key: key, task: task)
+        }
+    }
+
+    public func status(key: String) -> Signal<AyuAutoSendStatus, NoError> {
+        return self.statuses.get()
+        |> map { $0[key] ?? .stopped }
+        |> distinctUntilChanged
+    }
+
+    public func isRunning(key: String) -> Bool {
+        return self.tasks[key] != nil
+    }
+
+    /// Sends the template at once and then every interval. False if there is nothing to send.
+    public func start(context: AccountContext, peerId: EnginePeer.Id, threadId: Int64?) -> Bool {
+        let key = AyuAutoSender.key(context: context, peerId: peerId, threadId: threadId)
+        let template = self.template(key: key)
+        guard template.isSendable else {
+            return false
+        }
+        self.stop(key: key)
+        let task = Task(context: context, peerId: peerId, threadId: threadId, interval: template.interval)
+        self.tasks[key] = task
+        self.send(key: key)
+        self.schedule(key: key, task: task)
+        return true
+    }
+
+    public func stop(key: String) {
+        if let task = self.tasks.removeValue(forKey: key) {
+            task.timer?.invalidate()
+            self.updateStatuses()
+        }
+    }
+
+    private func stopAll() {
+        for key in Array(self.tasks.keys) {
+            self.stop(key: key)
+        }
+    }
+
+    private func schedule(key: String, task: Task) {
+        task.timer?.invalidate()
+        let timer = SwiftSignalKit.Timer(timeout: Double(task.interval), repeat: true, completion: { [weak self] in
+            self?.send(key: key)
+        }, queue: Queue.mainQueue())
+        task.timer = timer
+        timer.start()
+    }
+
+    private func send(key: String) {
+        guard let task = self.tasks[key] else {
+            return
+        }
+        let messages = AyuAutoSender.messages(context: task.context, template: self.template(key: key), threadId: task.threadId)
+        if messages.isEmpty {
+            self.stop(key: key)
+            return
+        }
+        let _ = enqueueMessages(account: task.context.account, peerId: task.peerId, messages: messages).startStandalone()
+        task.sentCount += 1
+        task.lastSent = Int32(Date().timeIntervalSince1970)
+        self.updateStatuses()
+    }
+
+    private func updateStatuses() {
+        var result: [String: AyuAutoSendStatus] = [:]
+        for (key, task) in self.tasks {
+            result[key] = AyuAutoSendStatus(isRunning: true, sentCount: task.sentCount, lastSent: task.lastSent)
+        }
+        self.statuses.set(result)
+    }
+
+    /// A fresh set of messages for each send: local media is uploaded anew every time.
+    private static func messages(context: AccountContext, template: AyuAutoSendTemplate, threadId: Int64?) -> [EnqueueMessage] {
+        let text = template.text.trimmingCharacters(in: .whitespacesAndNewlines)
+        var media: [AnyMediaReference] = []
+        if let directory = AyuAutoSender.mediaDirectory {
+            for item in template.media {
+                let path = directory.appendingPathComponent(item.fileName).path
+                guard FileManager.default.fileExists(atPath: path) else {
+                    continue
+                }
+                let dimensions = PixelDimensions(width: item.width, height: item.height)
+                if item.isVideo {
+                    let size = ((try? FileManager.default.attributesOfItem(atPath: path))?[.size] as? NSNumber)?.int64Value
+                    let resource = LocalFileReferenceMediaResource(localFilePath: path, randomId: Int64.random(in: Int64.min ... Int64.max))
+                    let file = TelegramMediaFile(
+                        fileId: EngineMedia.Id(namespace: Namespaces.Media.LocalFile, id: Int64.random(in: Int64.min ... Int64.max)),
+                        partialReference: nil,
+                        resource: resource,
+                        previewRepresentations: [],
+                        videoThumbnails: [],
+                        immediateThumbnailData: nil,
+                        mimeType: "video/mp4",
+                        size: size,
+                        attributes: [
+                            .Video(duration: item.duration, size: dimensions, flags: [.supportsStreaming], preloadSize: nil, coverTime: nil, videoCodec: nil),
+                            .FileName(fileName: "video.mp4")
+                        ],
+                        alternativeRepresentations: []
+                    )
+                    media.append(.standalone(media: file))
+                } else {
+                    guard let data = try? Data(contentsOf: URL(fileURLWithPath: path)) else {
+                        continue
+                    }
+                    let resource = LocalFileMediaResource(fileId: Int64.random(in: Int64.min ... Int64.max))
+                    context.engine.resources.storeResourceData(id: EngineMediaResource.Id(resource.id), data: data, synchronous: true)
+                    let image = TelegramMediaImage(
+                        imageId: EngineMedia.Id(namespace: Namespaces.Media.LocalImage, id: Int64.random(in: Int64.min ... Int64.max)),
+                        representations: [TelegramMediaImageRepresentation(dimensions: dimensions, resource: resource, progressiveSizes: [], immediateThumbnailData: nil, hasVideo: false, isPersonal: false)],
+                        immediateThumbnailData: nil,
+                        reference: nil,
+                        partialReference: nil,
+                        flags: []
+                    )
+                    media.append(.standalone(media: image))
+                }
+            }
+        }
+        if media.isEmpty {
+            if text.isEmpty {
+                return []
+            }
+            return [EnqueueMessage.message(text: text, attributes: [], inlineStickers: [:], mediaReference: nil, threadId: threadId, replyToMessageId: nil, replyToStoryId: nil, localGroupingKey: nil, correlationId: nil, bubbleUpEmojiOrStickersets: [])]
+        }
+        // Several items go as one album, with the text as its caption.
+        let groupingKey: Int64? = media.count > 1 ? Int64.random(in: Int64.min ... Int64.max) : nil
+        var messages: [EnqueueMessage] = []
+        for (index, mediaReference) in media.enumerated() {
+            messages.append(EnqueueMessage.message(text: index == 0 ? text : "", attributes: [], inlineStickers: [:], mediaReference: mediaReference, threadId: threadId, replyToMessageId: nil, replyToStoryId: nil, localGroupingKey: groupingKey, correlationId: nil, bubbleUpEmojiOrStickersets: []))
+        }
+        return messages
+    }
+}
