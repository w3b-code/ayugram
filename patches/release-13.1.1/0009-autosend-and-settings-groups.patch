+import Foundation
+import UIKit
+import AVFoundation
+import PhotosUI
+import UniformTypeIdentifiers
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import AccountContext
+import ItemListUI
+import PresentationDataUtils
+
+private final class AyuAutoSendArguments {
+    let updateText: (String) -> Void
+    let updateInterval: (String) -> Void
+    let addMedia: () -> Void
+    let removeMedia: (String) -> Void
+    let toggle: () -> Void
+
+    init(updateText: @escaping (String) -> Void, updateInterval: @escaping (String) -> Void, addMedia: @escaping () -> Void, removeMedia: @escaping (String) -> Void, toggle: @escaping () -> Void) {
+        self.updateText = updateText
+        self.updateInterval = updateInterval
+        self.addMedia = addMedia
+        self.removeMedia = removeMedia
+        self.toggle = toggle
+    }
+}
+
+private enum AyuAutoSendSection: Int32 {
+    case text
+    case media
+    case interval
+    case control
+}
+
+private enum AyuAutoSendEntry: ItemListNodeEntry {
+    case textHeader
+    case text(String)
+    case mediaHeader
+    case mediaItem(index: Int32, fileName: String, title: String)
+    case addMedia(enabled: Bool)
+    case mediaFooter
+    case intervalHeader
+    case interval(String)
+    case intervalFooter(String)
+    case toggle(isRunning: Bool)
+    case status(String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case .textHeader, .text:
+            return AyuAutoSendSection.text.rawValue
+        case .mediaHeader, .mediaItem, .addMedia, .mediaFooter:
+            return AyuAutoSendSection.media.rawValue
+        case .intervalHeader, .interval, .intervalFooter:
+            return AyuAutoSendSection.interval.rawValue
+        case .toggle, .status:
+            return AyuAutoSendSection.control.rawValue
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case .textHeader:
+            return 0
+        case .text:
+            return 1
+        case .mediaHeader:
+            return 2
+        case let .mediaItem(index, _, _):
+            return 10 + index
+        case .addMedia:
+            return 100
+        case .mediaFooter:
+            return 101
+        case .intervalHeader:
+            return 200
+        case .interval:
+            return 201
+        case .intervalFooter:
+            return 202
+        case .toggle:
+            return 300
+        case .status:
+            return 301
+        }
+    }
+
+    static func <(lhs: AyuAutoSendEntry, rhs: AyuAutoSendEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyuAutoSendArguments
+        switch self {
+        case .textHeader:
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: "ТЕКСТ", sectionId: self.section)
+        case let .text(text):
+            return ItemListMultilineInputItem(presentationData: presentationData, systemStyle: .glass, text: text, placeholder: "Текст сообщения", maxLength: ItemListMultilineInputItemTextLimit(value: 4096, display: false), sectionId: self.section, style: .blocks, textUpdated: { value in
+                arguments.updateText(value)
+            })
+        case .mediaHeader:
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: "МЕДИА", sectionId: self.section)
+        case let .mediaItem(_, fileName, title):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: .destructive, alignment: .natural, sectionId: self.section, style: .blocks, action: {
+                arguments.removeMedia(fileName)
+            })
+        case let .addMedia(enabled):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: "Добавить фото или видео", kind: enabled ? .generic : .disabled, alignment: .natural, sectionId: self.section, style: .blocks, action: {
+                arguments.addMedia()
+            })
+        case .mediaFooter:
+            return ItemListTextItem(presentationData: presentationData, text: .plain("До 10 фото и видео; несколько уходят одним альбомом, текст становится подписью. Нажатие на добавленное удаляет его."), sectionId: self.section)
+        case .intervalHeader:
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: "ИНТЕРВАЛ, СЕКУНД", sectionId: self.section)
+        case let .interval(text):
+            return ItemListSingleLineInputItem(presentationData: presentationData, systemStyle: .glass, title: NSAttributedString(), text: text, placeholder: "60", type: .number, sectionId: self.section, textUpdated: { value in
+                arguments.updateInterval(value)
+            }, action: {})
+        case let .intervalFooter(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case let .toggle(isRunning):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: isRunning ? "Остановить" : "Запустить", kind: isRunning ? .destructive : .generic, alignment: .center, sectionId: self.section, style: .blocks, action: {
+                arguments.toggle()
+            })
+        case let .status(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
+
+private struct AyuAutoSendState: Equatable {
+    var template: AyuAutoSendTemplate
+    var intervalText: String
+    var isImporting: Bool
+}
+
+private func ayuAutoSendIntervalDescription(_ seconds: Int32) -> String {
+    if seconds <= 0 {
+        return "Укажите интервал больше нуля."
+    }
+    let hours = seconds / 3600
+    let minutes = (seconds % 3600) / 60
+    let rest = seconds % 60
+    var parts: [String] = []
+    if hours > 0 {
+        parts.append("\(hours) ч")
+    }
+    if minutes > 0 {
+        parts.append("\(minutes) мин")
+    }
+    if rest > 0 {
+        parts.append("\(rest) с")
+    }
+    return "Сообщение уходит сразу после запуска и затем каждые \(parts.joined(separator: " ")). Отправка идёт, пока приложение открыто; в фоне — только с «Держать в фоне» в настройках AyuGram."
+}
+
+private func ayuAutoSendEntries(state: AyuAutoSendState, status: AyuAutoSendStatus) -> [AyuAutoSendEntry] {
+    var entries: [AyuAutoSendEntry] = []
+    entries.append(.textHeader)
+    entries.append(.text(state.template.text))
+    entries.append(.mediaHeader)
+    var photoIndex = 0
+    var videoIndex = 0
+    for (index, item) in state.template.media.enumerated() {
+        let title: String
+        if item.isVideo {
+            videoIndex += 1
+            let seconds = Int(item.duration.rounded())
+            title = "🎬 Видео \(videoIndex) · \(seconds / 60):\(String(format: "%02d", seconds % 60))"
+        } else {
+            photoIndex += 1
+            title = "📷 Фото \(photoIndex)"
+        }
+        entries.append(.mediaItem(index: Int32(index), fileName: item.fileName, title: title))
+    }
+    entries.append(.addMedia(enabled: !state.isImporting && state.template.media.count < 10))
+    entries.append(.mediaFooter)
+    entries.append(.intervalHeader)
+    entries.append(.interval(state.intervalText))
+    entries.append(.intervalFooter(ayuAutoSendIntervalDescription(state.template.interval)))
+    entries.append(.toggle(isRunning: status.isRunning))
+    if status.isRunning {
+        var text = "Работает. Отправлено: \(status.sentCount)"
+        if let lastSent = status.lastSent {
+            let formatter = DateFormatter()
+            formatter.dateFormat = "HH:mm:ss"
+            text += ", последнее в \(formatter.string(from: Date(timeIntervalSince1970: Double(lastSent))))"
+        }
+        entries.append(.status(text + "."))
+    } else if state.isImporting {
+        entries.append(.status("Подготовка медиа…"))
+    }
+    return entries
+}
+
+@available(iOS 14.0, *)
+private final class AyuAutoSendPickerDelegate: NSObject, PHPickerViewControllerDelegate {
+    let completion: ([PHPickerResult]) -> Void
+
+    init(completion: @escaping ([PHPickerResult]) -> Void) {
+        self.completion = completion
+    }
+
+    func picker(_ picker: PHPickerViewController, didFinishPicking results: [PHPickerResult]) {
+        picker.dismiss(animated: true)
+        self.completion(results)
+    }
+}
+
+/// The picker holds its delegate weakly.
+private var ayuAutoSendPickerDelegate: AnyObject?
+
+private func ayuAutoSendScaled(_ image: UIImage, maxSide: CGFloat) -> UIImage {
+    let factor = min(1.0, maxSide / max(image.size.width, image.size.height, 1.0))
+    let size = CGSize(width: floor(image.size.width * factor), height: floor(image.size.height * factor))
+    let format = UIGraphicsImageRendererFormat.default()
+    format.scale = 1.0
+    format.opaque = true
+    // Drawing also applies the photo's orientation to the pixels.
+    return UIGraphicsImageRenderer(size: size, format: format).image { _ in
+        image.draw(in: CGRect(origin: CGPoint(), size: size))
+    }
+}
+
+private func ayuAutoSendExportVideo(source: URL, directory: URL, completion: @escaping (AyuAutoSendMedia?) -> Void) {
+    let asset = AVURLAsset(url: source)
+    let fileName = UUID().uuidString + ".mp4"
+    let output = directory.appendingPathComponent(fileName)
+    guard let sessionValue = AVAssetExportSession(asset: asset, presetName: AVAssetExportPreset1920x1080) else {
+        try? FileManager.default.removeItem(at: source)
+        completion(nil)
+        return
+    }
+    #if compiler(>=6.0)
+    nonisolated(unsafe) let session = sessionValue
+    #else
+    let session = sessionValue
+    #endif
+    session.outputURL = output
+    session.outputFileType = .mp4
+    session.shouldOptimizeForNetworkUse = true
+    session.exportAsynchronously {
+        try? FileManager.default.removeItem(at: source)
+        guard session.status == .completed else {
+            try? FileManager.default.removeItem(at: output)
+            completion(nil)
+            return
+        }
+        let exported = AVURLAsset(url: output)
+        var size = CGSize(width: 1280.0, height: 720.0)
+        if let track = exported.tracks(withMediaType: .video).first {
+            let transformed = track.naturalSize.applying(track.preferredTransform)
+            size = CGSize(width: abs(transformed.width), height: abs(transformed.height))
+        }
+        completion(AyuAutoSendMedia(fileName: fileName, isVideo: true, width: Int32(size.width), height: Int32(size.height), duration: CMTimeGetSeconds(exported.duration)))
+    }
+}
+
+/// Copies a picked item into the app's folder: photos as JPEG, videos as MP4. Calls back on any queue.
+@available(iOS 14.0, *)
+private func ayuAutoSendImport(_ result: PHPickerResult, completion: @escaping (AyuAutoSendMedia?) -> Void) {
+    guard let directory = AyuAutoSender.mediaDirectory else {
+        completion(nil)
+        return
+    }
+    let provider = result.itemProvider
+    if provider.hasItemConformingToTypeIdentifier(UTType.movie.identifier) {
+        provider.loadFileRepresentation(forTypeIdentifier: UTType.movie.identifier, completionHandler: { url, _ in
+            guard let url = url else {
+                completion(nil)
+                return
+            }
+            // The system deletes the provided file once this handler returns.
+            let source = directory.appendingPathComponent(UUID().uuidString + "." + (url.pathExtension.isEmpty ? "mov" : url.pathExtension))
+            do {
+                try FileManager.default.copyItem(at: url, to: source)
+            } catch {
+                completion(nil)
+                return
+            }
+            ayuAutoSendExportVideo(source: source, directory: directory, completion: completion)
+        })
+    } else if provider.hasItemConformingToTypeIdentifier(UTType.image.identifier) {
+        provider.loadDataRepresentation(forTypeIdentifier: UTType.image.identifier, completionHandler: { data, _ in
+            guard let data = data, let image = UIImage(data: data) else {
+                completion(nil)
+                return
+            }
+            let scaled = ayuAutoSendScaled(image, maxSide: 2560.0)
+            let fileName = UUID().uuidString + ".jpg"
+            guard let jpeg = scaled.jpegData(compressionQuality: 0.9), (try? jpeg.write(to: directory.appendingPathComponent(fileName))) != nil else {
+                completion(nil)
+                return
+            }
+            completion(AyuAutoSendMedia(fileName: fileName, isVideo: false, width: Int32(scaled.size.width), height: Int32(scaled.size.height), duration: 0.0))
+        })
+    } else {
+        completion(nil)
+    }
+}
+
+/// The lightning button's screen: the chat's template, its interval, and start/stop.
+public func ayuAutoSendController(context: AccountContext, peerId: EnginePeer.Id, threadId: Int64?) -> ViewController {
+    let sender = AyuAutoSender.shared
+    let key = AyuAutoSender.key(context: context, peerId: peerId, threadId: threadId)
+    let initialTemplate = sender.template(key: key)
+    let statePromise = ValuePromise(AyuAutoSendState(template: initialTemplate, intervalText: "\(initialTemplate.interval)", isImporting: false), ignoreRepeated: true)
+    let stateValue = Atomic(value: AyuAutoSendState(template: initialTemplate, intervalText: "\(initialTemplate.interval)", isImporting: false))
+    let updateState: ((inout AyuAutoSendState) -> Void) -> Void = { f in
+        let updated = stateValue.modify { state in
+            var state = state
+            f(&state)
+            return state
+        }
+        statePromise.set(updated)
+        sender.setTemplate(updated.template, key: key)
+    }
+
+    var presentControllerImpl: ((ViewController) -> Void)?
+    var presentPickerImpl: (() -> Void)?
+
+    let arguments = AyuAutoSendArguments(updateText: { text in
+        updateState { $0.template.text = text }
+    }, updateInterval: { text in
+        let digits = text.filter { $0.isNumber }
+        updateState { state in
+            state.intervalText = digits
+            state.template.interval = Int32(clamping: Int(digits) ?? 0)
+        }
+    }, addMedia: {
+        presentPickerImpl?()
+    }, removeMedia: { fileName in
+        updateState { $0.template.media.removeAll(where: { $0.fileName == fileName }) }
+    }, toggle: {
+        if sender.isRunning(key: key) {
+            sender.stop(key: key)
+        } else if !sender.start(context: context, peerId: peerId, threadId: threadId) {
+            let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+            presentControllerImpl?(textAlertController(context: context, title: "Нечего отправлять", text: "Добавьте текст или медиа и укажите интервал больше нуля.", actions: [TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})]))
+        }
+    })
+
+    let signal = combineLatest(queue: .mainQueue(),
+        context.sharedContext.presentationData,
+        statePromise.get(),
+        sender.status(key: key)
+    )
+    |> map { presentationData, state, status -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Автоотправка"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: ayuAutoSendEntries(state: state, status: status), style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    presentControllerImpl = { [weak controller] c in
+        controller?.present(c, in: .window(.root))
+    }
+    presentPickerImpl = { [weak controller] in
+        guard #available(iOS 14.0, *), let controller = controller, var presenter = controller.view.window?.rootViewController else {
+            return
+        }
+        while let presented = presenter.presentedViewController {
+            presenter = presented
+        }
+        var configuration = PHPickerConfiguration()
+        configuration.filter = .any(of: [.images, .videos])
+        configuration.selectionLimit = max(1, 10 - stateValue.with { $0.template.media.count })
+        let picker = PHPickerViewController(configuration: configuration)
+        let delegate = AyuAutoSendPickerDelegate(completion: { results in
+            ayuAutoSendPickerDelegate = nil
+            if results.isEmpty {
+                return
+            }
+            updateState { $0.isImporting = true }
+            var imported: [Int: AyuAutoSendMedia] = [:]
+            var remaining = results.count
+            for (index, result) in results.enumerated() {
+                ayuAutoSendImport(result, completion: { media in
+                    // SwiftSignalKit's queue takes a plain closure, which may update these counters.
+                    Queue.mainQueue().async {
+                        if let media = media {
+                            imported[index] = media
+                        }
+                        remaining -= 1
+                        if remaining == 0 {
+                            let added = imported.keys.sorted().compactMap { imported[$0] }
+                            updateState { state in
+                                state.isImporting = false
+                                state.template.media.append(contentsOf: added.prefix(max(0, 10 - state.template.media.count)))
+                            }
+                        }
+                    }
+                })
+            }
+        })
+        ayuAutoSendPickerDelegate = delegate
+        picker.delegate = delegate
+        presenter.present(picker, animated: true)
+    }
+    return controller
+}
