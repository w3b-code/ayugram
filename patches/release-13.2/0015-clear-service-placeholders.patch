+/// AyuGram: removes the passive placeholders the notification extension shows for pushes that must not
+/// show anything (read or deleted elsewhere); iOS without Apple's filtering entitlement cannot drop them.
+private func ayuRemoveServicePlaceholders() {
+    UNUserNotificationCenter.current().getDeliveredNotifications { notifications in
+        let ids = notifications.filter { $0.request.content.threadIdentifier == "ayu-service-notifications" }.map { $0.request.identifier }
+        if !ids.isEmpty {
+            UNUserNotificationCenter.current().removeDeliveredNotifications(withIdentifiers: ids)
+        }
+    }
+}
