+
+extension ChatTextInputPanelNode {
+    fileprivate func ayuApplyStartButtonTheme(_ interfaceState: ChatPresentationInterfaceState) {
+        let isRestart = interfaceState.peerIsBlocked
+        self.ayuStartButtonIsRestart = isRestart
+        if isRestart {
+            let theme = interfaceState.theme
+            self.startButton.updateTheme(SolidRoundedButtonTheme(
+                backgroundColor: theme.list.itemDestructiveColor,
+                foregroundColor: .white,
+                disabledBackgroundColor: theme.list.plainBackgroundColor.mixedWith(theme.list.itemDisabledTextColor, alpha: 0.15),
+                disabledForegroundColor: theme.list.itemDisabledTextColor
+            ))
+        } else {
+            self.startButton.updateTheme(SolidRoundedButtonTheme(theme: interfaceState.theme))
+        }
+    }
+}
