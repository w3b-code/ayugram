+
+/// The media tags (photo, video, file…) a message gets once it has no self-destruct timer.
+private func ayuMediaTags(attributes: [MessageAttribute], media: [Media]) -> (MessageTags, GlobalMessageTags) {
+    return tagsForStoreMessage(incoming: true, attributes: attributes, media: media, textEntities: nil, isPinned: false)
+}
+
+/// Once: gives saved deleted media the photo/video tags that an earlier build left out, so tapping it
+/// opens that media instead of another one of the chat.
+func ayuRepairDeletedMediaTags(transaction: Transaction) {
+    let key = ValueBoxKey(length: 8)
+    key.setInt64(0, value: 0x6179757461677331)
+    if transaction.getPreferencesEntry(key: key)?.get(AyuUnreadRepairState.self)?.completed == true {
+        return
+    }
+    let index = transaction.getPreferencesEntry(key: ayuDeletedMessagesIndexKey)?.get(AyuDeletedMessagesIndex.self)
+    for item in index?.items ?? [] {
+        let id = MessageId(peerId: PeerId(item.peerId), namespace: item.namespace, id: item.id)
+        guard let message = transaction.getMessage(id), message.ayuDeletedAttribute != nil, !message.media.isEmpty else {
+            continue
+        }
+        let (mediaTags, mediaGlobalTags) = ayuMediaTags(attributes: message.attributes, media: message.media)
+        if message.tags.isSuperset(of: mediaTags) && message.globalTags.isSuperset(of: mediaGlobalTags) {
+            continue
+        }
+        transaction.updateMessage(id, update: { current in
+            let storeForwardInfo = current.forwardInfo.flatMap { forwardInfo in
+                StoreMessageForwardInfo(authorId: forwardInfo.author?.id, sourceId: forwardInfo.source?.id, sourceMessageId: forwardInfo.sourceMessageId, date: forwardInfo.date, authorSignature: forwardInfo.authorSignature, psaType: forwardInfo.psaType, flags: forwardInfo.flags)
+            }
+            return .update(StoreMessage(id: current.id, customStableId: nil, globallyUniqueId: current.globallyUniqueId, groupingKey: current.groupingKey, threadId: current.threadId, timestamp: current.timestamp, flags: StoreMessageFlags(current.flags), tags: current.tags.union(mediaTags), globalTags: current.globalTags.union(mediaGlobalTags), localTags: current.localTags, forwardInfo: storeForwardInfo, authorId: current.author?.id, text: current.text, attributes: current.attributes, media: current.media))
+        })
+    }
+    transaction.updatePreferencesEntry(key: key, { _ in PreferencesEntry(AyuUnreadRepairState(completed: true)) })
 }
