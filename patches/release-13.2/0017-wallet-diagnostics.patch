@@ -0,0 +1,21 @@
+import Foundation
+
+/// The wallet check in the AyuGram settings. The app registers a report for each account, since the
+/// settings module cannot reach the wallet itself. Reports never contain keys or the recovery phrase.
+public enum AyuWalletDiagnostics {
+    private static let lock = NSLock()
+    private static var providers: [Int64: () -> String] = [:]
+
+    public static func register(accountId: Int64, _ provider: @escaping () -> String) {
+        self.lock.lock()
+        self.providers[accountId] = provider
+        self.lock.unlock()
+    }
+
+    public static func report(accountId: Int64) -> String {
+        self.lock.lock()
+        let provider = self.providers[accountId]
+        self.lock.unlock()
+        return provider?() ?? "Кошелёк для этого аккаунта не запущен."
+    }
+}
