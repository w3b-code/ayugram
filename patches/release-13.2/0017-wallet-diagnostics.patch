diff --git a/submodules/TelegramUI/Sources/AyuWalletDiagnosticsReport.swift b/submodules/TelegramUI/Sources/AyuWalletDiagnosticsReport.swift
new file mode 100644
index 0000000000..32ad6fac8f
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuWalletDiagnosticsReport.swift
@@ -0,0 +1,37 @@
+import Foundation
+import WalletContext
+
+/// The wallet's state in words, without keys or the recovery phrase.
+func ayuDescribeWalletState(_ state: WalletContext.State) -> String {
+    var lines: [String] = []
+    switch state.phase {
+    case .restoring:
+        lines.append("Состояние: восстановление на этом устройстве")
+    case .creating:
+        lines.append("Состояние: создание кошелька")
+    case .empty:
+        lines.append("Состояние: кошелька нет (сервер не вернул кошелёк для аккаунта)")
+    case let .wallet(info):
+        lines.append("Состояние: кошелёк готов")
+        lines.append("Ключ для подписи на устройстве: " + (info.canSign ? "есть" : "нет"))
+        lines.append("Восстановление фразы из резервной копии: " + (info.canExportPhrase ? "доступно" : "недоступно"))
+        lines.append("Резервная копия на серверах: " + (info.backupEnabled ? "включена" : "выключена"))
+    case let .failed(error):
+        lines.append("Состояние: ошибка хранилища — \(error)")
+    }
+    lines.append("Адрес от сервера: " + (state.walletAddress == nil ? "не получен" : "получен"))
+    switch state.balance {
+    case .idle:
+        lines.append("Баланс: не загружался")
+    case .loading:
+        lines.append("Баланс: загружается")
+    case .value:
+        lines.append("Баланс: загружен")
+    case let .stale(_, error, _):
+        lines.append("Баланс: устарел, ошибка \(error)")
+    }
+    if let operation = state.activeOperation {
+        lines.append("Текущая операция: \(operation)")
+    }
+    return lines.joined(separator: "\n")
+}
